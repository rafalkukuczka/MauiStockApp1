<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             BackgroundColor="#07111F"
             Title="Markets">

    <Grid>
        <!-- Main Page -->
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*" Padding="0">

            <Border Grid.RowSpan="2" BackgroundColor="#0B1220" Stroke="#172033" StrokeThickness="1">
                <Grid RowDefinitions="Auto,*" Padding="22">
                    <Label Text="Maui Markets"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="24"
                           Margin="0,10,0,28" />

                    <VerticalStackLayout Grid.Row="1" Spacing="12">
                        <Button Text="Overview" BackgroundColor="#2563EB" TextColor="White" CornerRadius="12" />
                        <Button Text="Watchlist" BackgroundColor="#111827" TextColor="#CBD5E1" CornerRadius="12" />
                        <Button Text="Portfolio" BackgroundColor="#111827" TextColor="#CBD5E1" CornerRadius="12" />
                        <Button Text="SQLite Data" BackgroundColor="#111827" TextColor="#CBD5E1" CornerRadius="12" />
                        <Button Text="Settings" Clicked="OnModal" BackgroundColor="#2563EB" TextColor="White" CornerRadius="12"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Row="0" Padding="28,20" ColumnDefinitions="*,Auto" BackgroundColor="#07111F">
                <VerticalStackLayout>
                    <Label Text="Markets" TextColor="White" FontSize="34" FontAttributes="Bold" />
                    <Label Text="MAUI + SQLite local candlestick dashboard" TextColor="#94A3B8" FontSize="14" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Button Text="Add tick" Clicked="OnAddTickClicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="12" />
                    <Button Text="Reset DB" Clicked="OnResetClicked" BackgroundColor="#1E293B" TextColor="White" CornerRadius="12" />
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Column="1" Grid.Row="1" Padding="28" RowDefinitions="Auto,*,Auto" RowSpacing="18">

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                    <Border BackgroundColor="#101B2D" Stroke="#1E293B" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="AAPL" TextColor="#94A3B8" FontSize="13" />
                            <Label x:Name="LastPriceLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#101B2D" Stroke="#1E293B" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="Change" TextColor="#94A3B8" FontSize="13" />
                            <Label x:Name="ChangeLabel" Text="--" TextColor="#22C55E" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" BackgroundColor="#101B2D" Stroke="#1E293B" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="Rows in SQLite" TextColor="#94A3B8" FontSize="13" />
                            <Label x:Name="RowsLabel" Text="--" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" BackgroundColor="#101B2D" Stroke="#1E293B" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label Text="Database" TextColor="#94A3B8" FontSize="13" />
                            <Label Text="stocks.db3" TextColor="White" FontSize="26" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Grid.Row="1" BackgroundColor="#101B2D" Stroke="#1E293B" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 18">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Apple Inc." TextColor="White" FontSize="22" FontAttributes="Bold" />
                                <Label Text="Candlestick chart rendered by GraphicsView" TextColor="#94A3B8" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="1D" TextColor="White" BackgroundColor="#2563EB" Padding="16,8" />
                        </Grid>

                        <GraphicsView x:Name="ChartView" Grid.Row="1" HeightRequest="420" Margin="0,18,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" BackgroundColor="#101B2D" Stroke="#1E293B" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout>
                        <Label Text="Recent SQLite rows" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,0,0,10" />
                        <CollectionView x:Name="RowsView" HeightRequest="160">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="160,*,*,*,*,*" Padding="8" ColumnSpacing="12">
                                        <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}" TextColor="#CBD5E1" />
                                        <Label Grid.Column="1" Text="{Binding Open, StringFormat='Open {0:0.00}'}" TextColor="#CBD5E1" />
                                        <Label Grid.Column="2" Text="{Binding High, StringFormat='High {0:0.00}'}" TextColor="#CBD5E1" />
                                        <Label Grid.Column="3" Text="{Binding Low, StringFormat='Low {0:0.00}'}" TextColor="#CBD5E1" />
                                        <Label Grid.Column="4" Text="{Binding Close, StringFormat='Close {0:0.00}'}" TextColor="White" FontAttributes="Bold" />
                                        <Label Grid.Column="5" Text="{Binding Volume}" TextColor="#94A3B8" HorizontalTextAlignment="End" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- Overlay -->
        <Grid x:Name="SettingsOverlay"
                  IsVisible="False"
                  BackgroundColor="#99000000">

            <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="1"
                    Padding="24"
                    MaximumWidthRequest="600"
                    MaximumHeightRequest="700"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*,Auto"
                          RowSpacing="16">

                    <Label Text="Settings"
                               FontSize="28"
                               TextColor="White"
                               FontAttributes="Bold" />

                    <VerticalStackLayout Grid.Row="1"
                                             Spacing="12">
                        <Label Text="API Key" TextColor="White" />
                        <Entry Placeholder="Enter API key" />

                        <Label Text="Refresh interval" TextColor="White" />
                        <Entry Placeholder="Seconds" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Row="2"
                                               HorizontalOptions="End"
                                               Spacing="12">
                        <Button Text="Cancel"
                                    Clicked="OnClose" BackgroundColor="#111827" TextColor="#CBD5E1" CornerRadius="12"/>

                        <Button Text="Save"
                                    Clicked="OnSave" BackgroundColor="#2563EB" TextColor="White" CornerRadius="12" />
                    </HorizontalStackLayout>

                </Grid>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
